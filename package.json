{
  "name": "dsh-master-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm typecheck && pnpm test && pnpm build && vitest run --config vitest.e2e.config.ts",
    "e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "mutate": "node scripts/mutate.mjs"
  },
  "devDependencies": {
    "@dsh-master/testkit": "workspace:*",
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.28.2"
}
